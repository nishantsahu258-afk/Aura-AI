# Server Port (assigned by Render or defaults to 5000 locally)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/aura?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aura

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origin for CORS (comma-separated for multiple origins, e.g. local + Vercel)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional: Daily global message rate cap to protect quota
DAILY_MESSAGE_CAP=2000
